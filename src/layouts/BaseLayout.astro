---
import "../styles/global.css";
import type { Lang } from "../i18n/copy";
import { t } from "../i18n/copy";
import Splash from "../components/Splash.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t(lang);
const htmlLang = lang === "zh" ? "zh-Hans" : "en";
---

<!doctype html>
<html lang={htmlLang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={c.metaDescription} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Noto+Sans+SC:wght@400;600;700&family=Sora:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{c.metaTitle}</title>
    <script is:inline>
      (function () {
        try {
          var key = "firework-ess-theme";
          var saved = localStorage.getItem(key);
          var theme =
            saved === "light" || saved === "dark"
              ? saved
              : window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <Splash lang={lang} />
    <slot />
  </body>
</html>
