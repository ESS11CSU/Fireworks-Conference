---
import type { Lang } from "../i18n/copy";
import { t } from "../i18n/copy";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t(lang);
const accents = ["from-fuchsia-500", "from-cyan-400", "from-amber-300", "from-lime-300"];
---

<div id="top" class="relative overflow-x-hidden">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[720px] bg-[radial-gradient(ellipse_at_top,rgba(255,77,141,0.22),transparent_55%),radial-gradient(ellipse_at_20%_30%,rgba(92,225,255,0.16),transparent_40%)]"
  >
  </div>
  <SiteHeader lang={lang} />

  <main>
    <section class="relative mx-auto max-w-6xl px-5 pb-20 pt-16 sm:pt-24">
      <p class="text-xs font-semibold uppercase tracking-[0.32em] text-cyan-200">
        {c.heroEyebrow}
      </p>
      <h1
        class="mt-5 max-w-4xl font-display text-4xl leading-[1.15] text-white sm:text-6xl"
      >
        {c.heroTitle}
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-white/75 sm:text-lg">
        {c.heroLead}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#agenda"
          class="rounded-full bg-gradient-to-r from-fuchsia-500 to-amber-400 px-6 py-3 text-sm font-semibold text-night"
        >
          {c.heroPrimary}
        </a>
        <a
          href="#speakers"
          class="rounded-full border border-white/25 px-6 py-3 text-sm font-semibold text-white hover:border-amber-200"
        >
          {c.heroSecondary}
        </a>
      </div>
      <dl class="mt-14 grid max-w-xl grid-cols-3 gap-6">
        {
          c.stats.map((stat) => (
            <div>
              <dt class="text-xs uppercase tracking-[0.2em] text-white/45">{stat.label}</dt>
              <dd class="mt-1 font-display text-3xl text-amber-200">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section id="about" class="mx-auto max-w-6xl px-5 py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.32em] text-fuchsia-300">
        {c.aboutKicker}
      </p>
      <h2 class="mt-3 max-w-3xl font-display text-3xl text-white sm:text-4xl">
        {c.aboutTitle}
      </h2>
      <p class="mt-5 max-w-3xl text-white/70">{c.aboutBody}</p>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {
          c.pillars.map((pillar, index) => (
            <article class="rounded-3xl border border-white/10 bg-white/5 p-6">
              <div
                class:list={[
                  "mb-4 h-1.5 w-12 rounded-full bg-gradient-to-r to-transparent",
                  accents[index] ?? "from-white",
                ]}
              />
              <h3 class="font-display text-xl text-white">{pillar.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-white/65">{pillar.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="agenda" class="mx-auto max-w-6xl px-5 py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.32em] text-amber-200">
        {c.agendaKicker}
      </p>
      <h2 class="mt-3 font-display text-3xl text-white sm:text-4xl">{c.agendaTitle}</h2>
      <p class="mt-3 text-sm text-white/55">{c.agendaNote}</p>
      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          c.days.map((day) => (
            <article class="rounded-3xl bg-gradient-to-b from-fuchsia-500/15 to-white/5 p-6 ring-1 ring-white/10">
              <p class="text-xs uppercase tracking-[0.22em] text-cyan-200">{day.date}</p>
              <h3 class="mt-2 font-display text-2xl text-amber-100">{day.title}</h3>
              <ul class="mt-6 space-y-4">
                {day.items.map((item) => (
                  <li class="flex gap-4 text-sm">
                    <span class="w-14 shrink-0 font-semibold text-fuchsia-200">{item.time}</span>
                    <span class="text-white/80">{item.title}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section id="speakers" class="mx-auto max-w-6xl px-5 py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.32em] text-lime-200">
        {c.speakersKicker}
      </p>
      <h2 class="mt-3 font-display text-3xl text-white sm:text-4xl">{c.speakersTitle}</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        {
          c.speakers.map((speaker) => (
            <article class="rounded-3xl border border-white/10 p-6">
              <h3 class="font-display text-2xl text-white">{speaker.name}</h3>
              <p class="mt-1 text-sm text-cyan-200">{speaker.role}</p>
              <p class="mt-4 text-white/70">“{speaker.talk}”</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="venue" class="mx-auto max-w-6xl px-5 py-20">
      <div class="overflow-hidden rounded-[2rem] border border-white/10 bg-[linear-gradient(135deg,#2a0a3d,transparent_50%),linear-gradient(320deg,#12324a,transparent_40%)] p-8 sm:p-12">
        <p class="text-xs font-semibold uppercase tracking-[0.32em] text-cyan-200">
          {c.venueKicker}
        </p>
        <h2 class="mt-3 font-display text-3xl text-white sm:text-4xl">{c.venueTitle}</h2>
        <p class="mt-5 max-w-2xl text-white/70">{c.venueBody}</p>
        <dl class="mt-8 grid gap-6 sm:grid-cols-3">
          {
            c.venueFacts.map((fact) => (
              <div>
                <dt class="text-xs uppercase tracking-[0.2em] text-white/45">{fact.label}</dt>
                <dd class="mt-1 text-white">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>
  </main>

  <footer class="border-t border-white/10 px-5 py-10 text-center text-sm text-white/50">
    <p>{c.footerCredit}</p>
    <p class="mt-2">{c.footerNote}</p>
  </footer>
</div>
