---
import type { Lang } from "../i18n/copy";
import { t } from "../i18n/copy";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t(lang);
const accents = ["from-fuchsia-500", "from-cyan-400", "from-amber-300", "from-lime-300"];
---

<div id="top" class="relative overflow-x-hidden">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[720px] bg-[radial-gradient(ellipse_at_top,rgba(255,77,141,0.22),transparent_55%),radial-gradient(ellipse_at_20%_30%,rgba(92,225,255,0.16),transparent_40%)]"
  >
  </div>
  <SiteHeader lang={lang} />

  <main>
    <section class="relative mx-auto max-w-6xl px-5 pb-20 pt-16 sm:pt-24">
      <p class="text-xs font-semibold uppercase tracking-[0.32em] text-cyan-200">
        {c.heroEyebrow}
      </p>
      <h1
        class="mt-5 max-w-4xl font-display text-4xl leading-[1.15] text-white sm:text-6xl"
      >
        {c.heroTitle}
      </h1>
      <div class="mt-6 max-w-2xl space-y-2 text-base leading-relaxed text-white/75 sm:text-lg">
        <p>{c.heroLeadTitle}</p>
        <p>{c.heroLeadOrganizers}</p>
        <p>{c.heroLeadHost}</p>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#submit"
          class="rounded-full bg-gradient-to-r from-fuchsia-500 to-amber-400 px-6 py-3 text-sm font-semibold text-night"
        >
          {c.heroPrimary}
        </a>
        <a
          href="#speakers"
          class="rounded-full border border-white/25 px-6 py-3 text-sm font-semibold text-white hover:border-amber-200"
        >
          {c.heroSecondary}
        </a>
      </div>
      <dl class="mt-14 grid max-w-xl grid-cols-3 gap-6">
        {
          c.facts.map((fact) => (
            <div>
              <dt class="text-xs uppercase tracking-[0.2em] text-white/45">{fact.label}</dt>
              <dd class="mt-1 font-display text-xl text-amber-200 sm:text-2xl">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section id="about" class="mx-auto max-w-6xl px-5 py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.32em] text-fuchsia-300">
        {c.aboutKicker}
      </p>
      <h2 class="mt-3 max-w-3xl font-display text-3xl text-white sm:text-4xl">
        {c.aboutTitle}
      </h2>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
        <div>
          <p class="text-white/70">{c.aboutBody}</p>
          <p class="mt-4 text-white/70">{c.aboutBody2}</p>
        </div>
        <figure class="overflow-hidden rounded-3xl border border-white/10">
          <!-- Decorative academic stock photo only; no conference-specific claims. -->
          <img
            src="/images/about-academic.jpg"
            alt={c.aboutImageAlt}
            class="h-full max-h-[28rem] w-full object-cover"
            width="1600"
            height="1067"
          />
          <figcaption class="px-4 py-2 text-xs text-white/40">{c.aboutImageCredit}</figcaption>
        </figure>
      </div>
      <dl class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
          <dt class="text-xs uppercase tracking-[0.2em] text-white/45">{c.organizersLabel}</dt>
          <dd class="mt-2 text-white">{c.organizersValue}</dd>
        </div>
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
          <dt class="text-xs uppercase tracking-[0.2em] text-white/45">{c.hostLabel}</dt>
          <dd class="mt-2 text-white">{c.hostValue}</dd>
        </div>
      </dl>
      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          c.orgs.map((org) => (
            <article class="rounded-3xl border border-white/10 bg-white/5 p-6">
              <h3 class="font-display text-xl text-white">{org.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-white/65">{org.body}</p>
              <a
                class="mt-4 inline-block text-sm text-cyan-200 underline-offset-4 hover:underline"
                href={org.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {org.href.replace("https://", "")}
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section id="topics" class="mx-auto max-w-6xl px-5 py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.32em] text-lime-200">
        {c.topicsKicker}
      </p>
      <h2 class="mt-3 font-display text-3xl text-white sm:text-4xl">{c.topicsTitle}</h2>
      <p class="mt-5 max-w-3xl text-white/70">{c.topicsNote}</p>
      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        {
          c.topics.map((topic, index) => (
            <article class="rounded-3xl border border-white/10 bg-white/5 p-6">
              <div
                class:list={[
                  "mb-4 h-1.5 w-12 rounded-full bg-gradient-to-r to-transparent",
                  accents[index] ?? "from-white",
                ]}
              />
              <h3 class="font-display text-xl text-white">{topic}</h3>
            </article>
          ))
        }
      </div>
    </section>

    <section id="program" class="mx-auto max-w-6xl px-5 py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.32em] text-amber-200">
        {c.programKicker}
      </p>
      <h2 class="mt-3 font-display text-3xl text-white sm:text-4xl">{c.programTitle}</h2>
      <div class="mt-10 rounded-3xl bg-gradient-to-b from-fuchsia-500/15 to-white/5 p-8 ring-1 ring-white/10 sm:p-12">
        <p class="text-xs uppercase tracking-[0.22em] text-cyan-200">{c.programDates}</p>
        <p class="mt-3 font-display text-3xl text-amber-100">{c.programNote}</p>
        <p class="mt-4 max-w-2xl text-white/70">{c.programDetail}</p>
      </div>
    </section>

    <section id="speakers" class="mx-auto max-w-6xl px-5 py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.32em] text-lime-200">
        {c.speakersKicker}
      </p>
      <h2 class="mt-3 font-display text-3xl text-white sm:text-4xl">{c.speakersTitle}</h2>
      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        {
          c.speakers.map((speaker) => (
            <article class="rounded-3xl border border-white/10 p-6">
              <div class="flex gap-4">
                {/* TODO: Neutral placeholder until a rights-safe official headshot is confirmed. */}
                <img
                  src={speaker.photo}
                  alt={speaker.name}
                  class="h-24 w-24 shrink-0 rounded-2xl object-cover ring-1 ring-white/10"
                  width="96"
                  height="96"
                />
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-fuchsia-200">
                    {speaker.badge}
                  </p>
                  <h3 class="mt-2 font-display text-2xl text-white">{speaker.name}</h3>
                  <p class="mt-1 text-sm text-cyan-200">{speaker.role}</p>
                </div>
              </div>
              <p class="mt-4 text-sm leading-relaxed text-white/70">{speaker.bio}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="leadership" class="mx-auto max-w-6xl px-5 py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.32em] text-cyan-200">
        {c.leadershipKicker}
      </p>
      <h2 class="mt-3 font-display text-3xl text-white sm:text-4xl">{c.leadershipTitle}</h2>
      <h3 class="mt-10 text-sm font-semibold uppercase tracking-[0.2em] text-amber-200">
        {c.chairsLabel}
      </h3>
      <div class="mt-4 grid gap-5 md:grid-cols-3">
        {
          c.chairs.map((person) => (
            <article class="rounded-3xl border border-white/10 bg-white/5 p-6">
              <h4 class="font-display text-xl text-white">{person.name}</h4>
              <p class="mt-2 text-sm text-white/65">{person.role}</p>
            </article>
          ))
        }
      </div>
      <h3 class="mt-12 text-sm font-semibold uppercase tracking-[0.2em] text-amber-200">
        {c.committeeLabel}
      </h3>
      <div class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          c.committee.map((person) => (
            <article class="rounded-3xl border border-white/10 p-6">
              <h4 class="font-display text-xl text-white">{person.name}</h4>
              <p class="mt-2 text-sm text-white/65">{person.role}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="submit" class="mx-auto max-w-6xl px-5 py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.32em] text-fuchsia-300">
        {c.submitKicker}
      </p>
      <h2 class="mt-3 font-display text-3xl text-white sm:text-4xl">{c.submitTitle}</h2>
      <p class="mt-5 max-w-3xl text-white/70">{c.submitInvite}</p>
      <ul class="mt-4 list-disc space-y-1 pl-5 text-white/80">
        {c.submitMaterials.map((item) => <li>{item}</li>)}
      </ul>
      <p class="mt-6 max-w-3xl text-white/70">{c.submitHow}</p>
      <p class="mt-3 font-mono text-sm text-amber-200">{c.submitSubject}</p>
      <p class="mt-6 text-xs uppercase tracking-[0.2em] text-white/45">{c.submitEmailLabel}</p>
      <a class="text-lg text-cyan-200 underline-offset-4 hover:underline" href={`mailto:${c.submitEmail}`}>
        {c.submitEmail}
      </a>
      <p class="mt-6 max-w-3xl text-white/70">{c.reviewNote}</p>
      <dl class="mt-8 grid gap-5 sm:grid-cols-2">
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
          <dt class="text-xs uppercase tracking-[0.2em] text-white/45">{c.deadlineLabel}</dt>
          <dd class="mt-2 text-white">{c.deadlineValue}</dd>
        </div>
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
          <dt class="text-xs uppercase tracking-[0.2em] text-white/45">{c.acceptanceLabel}</dt>
          <dd class="mt-2 text-white">{c.acceptanceValue}</dd>
        </div>
      </dl>
      <h3 class="mt-10 text-sm font-semibold uppercase tracking-[0.2em] text-amber-200">
        {c.feesLabel}
      </h3>
      <div class="mt-4 grid gap-5 sm:grid-cols-2">
        {
          c.fees.map((fee) => (
            <article class="rounded-3xl bg-gradient-to-b from-fuchsia-500/15 to-white/5 p-6 ring-1 ring-white/10">
              <p class="text-sm text-white/65">{fee.label}</p>
              <p class="mt-2 font-display text-3xl text-amber-100">{fee.value}</p>
            </article>
          ))
        }
      </div>
      <h3 class="mt-10 text-sm font-semibold uppercase tracking-[0.2em] text-amber-200">
        {c.mealsLabel}
      </h3>
      <p class="mt-3 max-w-3xl text-white/70">{c.mealsValue}</p>
    </section>

    <section id="venue" class="mx-auto max-w-6xl px-5 py-20">
      <div class="overflow-hidden rounded-[2rem] border border-white/10 bg-[linear-gradient(135deg,#2a0a3d,transparent_50%),linear-gradient(320deg,#12324a,transparent_40%)] p-8 sm:p-12">
        <p class="text-xs font-semibold uppercase tracking-[0.32em] text-cyan-200">
          {c.venueKicker}
        </p>
        <h2 class="mt-3 font-display text-3xl text-white sm:text-4xl">{c.venueTitle}</h2>
        <p class="mt-5 max-w-2xl text-white/70">{c.venueBody}</p>
        <dl class="mt-8 grid gap-6 sm:grid-cols-3">
          {
            c.venueFacts.map((fact) => (
              <div>
                <dt class="text-xs uppercase tracking-[0.2em] text-white/45">{fact.label}</dt>
                <dd class="mt-1 text-white">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
        <h3 class="mt-10 text-sm font-semibold uppercase tracking-[0.2em] text-amber-200">
          {c.contactTitle}
        </h3>
        <div class="mt-4 grid gap-5 sm:grid-cols-2">
          {
            c.contacts.map((person) => (
              <div>
                <p class="text-white">{person.name}</p>
                <p class="mt-1 text-sm text-white/65">{person.role}</p>
                <a class="mt-1 inline-block text-cyan-200" href={`tel:${person.phone}`}>
                  {person.phone}
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-white/10 px-5 py-10 text-center text-sm text-white/50">
    <p>{c.footerCredit}</p>
    <p class="mt-3">
      <a
        class="text-cyan-200 underline-offset-4 hover:underline"
        href={c.essHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        {c.essLinkLabel}
      </a>
    </p>
    <p class="mt-2">{c.footerNote}</p>
  </footer>
</div>
