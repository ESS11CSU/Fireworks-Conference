---
import type { Lang } from "../i18n/copy";
import { t } from "../i18n/copy";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t(lang);
const accents = ["from-fuchsia-500", "from-cyan-400", "from-amber-300", "from-lime-300"];
const isZh = lang === "zh";
const titleClass = isZh ? "font-sans font-bold" : "font-display";
const kickerClass = isZh ? "font-sans font-bold" : "font-semibold";
---

<div id="top" class="relative overflow-x-hidden">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[720px]" style="background: var(--hero-glow);">
  </div>
  <SiteHeader lang={lang} />

  <main>
    <section class="relative mx-auto max-w-6xl px-5 pb-20 pt-16 sm:pt-24">
      <p class:list={["text-xs uppercase tracking-[0.32em]", kickerClass]} style="color: var(--accent-cyan);">
        {c.heroEyebrow}
      </p>
      <h1 class:list={["mt-5 max-w-4xl text-4xl leading-[1.15] sm:text-6xl", titleClass]} style="color: var(--ink);">
        {c.heroTitle}
      </h1>
      <div class="mt-6 max-w-2xl space-y-2 text-base leading-relaxed sm:text-lg" style="color: var(--muted);">
        <p>{c.heroLeadTitle}</p>
        <p>{c.heroLeadOrganizers}</p>
        <p>{c.heroLeadHost}</p>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#submit"
          class="rounded-full bg-gradient-to-r from-fuchsia-500 to-amber-400 px-6 py-3 text-sm font-semibold text-night"
        >
          {c.heroPrimary}
        </a>
        <a
          href="#speakers"
          class="rounded-full border px-6 py-3 text-sm font-semibold"
          style="border-color: var(--line-strong); color: var(--ink);"
        >
          {c.heroSecondary}
        </a>
      </div>
      <dl class="mt-14 grid w-full max-w-4xl grid-cols-1 gap-6 sm:grid-cols-3 sm:gap-8">
        {
          c.facts.map((fact) => (
            <div class="min-w-0">
              <dt class:list={["text-xs uppercase tracking-[0.2em]", kickerClass]} style="color: var(--faint);">
                {fact.label}
              </dt>
              <dd
                class:list={["mt-1 text-lg sm:text-xl", titleClass, "whitespace-nowrap"]}
                style="color: var(--accent-gold);"
              >
                {fact.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section id="about" class="mx-auto max-w-6xl px-5 py-20">
      <p class:list={["text-xs uppercase tracking-[0.32em]", kickerClass]} style="color: var(--accent-fuchsia);">
        {c.aboutKicker}
      </p>
      <h2 class:list={["mt-3 max-w-3xl text-3xl sm:text-4xl", titleClass]} style="color: var(--ink);">
        {c.aboutTitle}
      </h2>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
        <div style="color: var(--muted);">
          <p>{c.aboutBody}</p>
          <p class="mt-4">{c.aboutBody2}</p>
        </div>
        <figure class="card-hover overflow-hidden rounded-3xl">
          <!-- Decorative academic stock photo only; no conference-specific claims. -->
          <img
            src="/images/about-academic.jpg"
            alt={c.aboutImageAlt}
            class="h-full max-h-[28rem] w-full object-cover"
            width="1600"
            height="1067"
          />
          <figcaption class="px-4 py-2 text-xs" style="color: var(--faint);">{c.aboutImageCredit}</figcaption>
        </figure>
      </div>
      <dl class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="card-hover rounded-3xl p-6" style="background: var(--card);">
          <dt class="text-xs uppercase tracking-[0.2em]" style="color: var(--faint);">{c.organizersLabel}</dt>
          <dd class="mt-2" style="color: var(--ink);">{c.organizersValue}</dd>
        </div>
        <div class="card-hover rounded-3xl p-6" style="background: var(--card);">
          <dt class="text-xs uppercase tracking-[0.2em]" style="color: var(--faint);">{c.hostLabel}</dt>
          <dd class="mt-2" style="color: var(--ink);">{c.hostValue}</dd>
        </div>
      </dl>
      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          c.orgs.map((org) => (
            <article class="card-hover rounded-3xl p-6" style="background: var(--card);">
              <h3 class:list={["text-xl", titleClass]} style="color: var(--ink);">{org.title}</h3>
              <p class="mt-3 text-sm leading-relaxed" style="color: var(--muted);">{org.body}</p>
              <a
                class="mt-4 inline-block text-sm underline-offset-4 hover:underline"
                href={org.href}
                target="_blank"
                rel="noopener noreferrer"
                style="color: var(--accent-cyan);"
              >
                {org.href.replace("https://", "")}
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section id="topics" class="mx-auto max-w-6xl px-5 py-20">
      <p class:list={["text-xs uppercase tracking-[0.32em]", kickerClass]} style="color: var(--accent-lime);">
        {c.topicsKicker}
      </p>
      <h2 class:list={["mt-3 text-3xl sm:text-4xl", titleClass]} style="color: var(--ink);">{c.topicsTitle}</h2>
      <p class="mt-5 max-w-3xl" style="color: var(--muted);">{c.topicsNote}</p>
      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        {
          c.topics.map((topic, index) => (
            <article class="card-hover rounded-3xl p-6" style="background: var(--card);">
              <div
                class:list={[
                  "mb-4 h-1.5 w-12 rounded-full bg-gradient-to-r to-transparent",
                  accents[index] ?? "from-white",
                ]}
              />
              <h3 class:list={["text-xl", titleClass]} style="color: var(--ink);">{topic}</h3>
            </article>
          ))
        }
      </div>
    </section>

    <section id="program" class="mx-auto max-w-6xl px-5 py-20">
      <p class:list={["text-xs uppercase tracking-[0.32em]", kickerClass]} style="color: var(--accent-gold);">
        {c.programKicker}
      </p>
      <h2 class:list={["mt-3 text-3xl sm:text-4xl", titleClass]} style="color: var(--ink);">{c.programTitle}</h2>
      <div class="card-hover mt-10 rounded-3xl p-8 sm:p-12" style="background: var(--program-wash);">
        <p class:list={["text-xs uppercase tracking-[0.22em]", kickerClass]} style="color: var(--accent-cyan);">{c.programDates}</p>
        <p class:list={["mt-3 text-3xl", titleClass]} style="color: var(--accent-gold);">{c.programNote}</p>
        <p class="mt-4 max-w-2xl" style="color: var(--muted);">{c.programDetail}</p>
      </div>
    </section>

    <section id="speakers" class="mx-auto max-w-6xl px-5 py-20">
      <p class:list={["text-xs uppercase tracking-[0.32em]", kickerClass]} style="color: var(--accent-lime);">
        {c.speakersKicker}
      </p>
      <h2 class:list={["mt-3 text-3xl sm:text-4xl", titleClass]} style="color: var(--ink);">{c.speakersTitle}</h2>
      <div class="mt-10 flex flex-col gap-6">
        {
          c.speakers.map((speaker) => (
            <article class="card-hover rounded-3xl p-6 sm:p-8" style="background: var(--card);">
              <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
                <img
                  src={speaker.photo}
                  alt={speaker.name}
                  class="speaker-photo w-36 shrink-0 rounded-2xl object-cover sm:w-44"
                  width="176"
                  height="235"
                />
                <div class="min-w-0 flex-1">
                  <p class:list={["text-xs uppercase tracking-[0.2em]", kickerClass]} style="color: var(--accent-fuchsia);">
                    {speaker.badge}
                  </p>
                  <h3 class:list={["mt-2 text-2xl sm:text-3xl", titleClass]} style="color: var(--ink);">{speaker.name}</h3>
                  <p class="mt-1 text-sm sm:text-base" style="color: var(--accent-cyan);">{speaker.role}</p>
                  <p class="mt-4 text-sm leading-relaxed sm:text-base" style="color: var(--muted);">{speaker.bio}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section id="leadership" class="mx-auto max-w-6xl px-5 py-20">
      <p class:list={["text-xs uppercase tracking-[0.32em]", kickerClass]} style="color: var(--accent-cyan);">
        {c.leadershipKicker}
      </p>
      <h2 class:list={["mt-3 text-3xl sm:text-4xl", titleClass]} style="color: var(--ink);">{c.leadershipTitle}</h2>
      <h3 class:list={["mt-10 text-sm uppercase tracking-[0.2em]", kickerClass]} style="color: var(--accent-gold);">
        {c.chairsLabel}
      </h3>
      <div class="mt-4 grid gap-5 md:grid-cols-3">
        {
          c.chairs.map((person) => (
            <article class="card-hover rounded-3xl p-6" style="background: var(--card);">
              <h4 class:list={["text-xl", titleClass]} style="color: var(--ink);">{person.name}</h4>
              <p class="mt-2 text-sm" style="color: var(--muted);">{person.role}</p>
            </article>
          ))
        }
      </div>
      <h3 class:list={["mt-12 text-sm uppercase tracking-[0.2em]", kickerClass]} style="color: var(--accent-gold);">
        {c.committeeLabel}
      </h3>
      <div class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          c.committee.map((person) => (
            <article class="card-hover rounded-3xl p-6" style="background: var(--card);">
              <h4 class:list={["text-xl", titleClass]} style="color: var(--ink);">{person.name}</h4>
              <p class="mt-2 text-sm" style="color: var(--muted);">{person.role}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="submit" class="mx-auto max-w-6xl px-5 py-20">
      <p class:list={["text-xs uppercase tracking-[0.32em]", kickerClass]} style="color: var(--accent-fuchsia);">
        {c.submitKicker}
      </p>
      <h2 class:list={["mt-3 text-3xl sm:text-4xl", titleClass]} style="color: var(--ink);">{c.submitTitle}</h2>
      <p class="mt-5 max-w-3xl" style="color: var(--muted);">{c.submitInvite}</p>
      <ul class="mt-4 list-disc space-y-1 pl-5" style="color: var(--ink);">
        {c.submitMaterials.map((item) => <li>{item}</li>)}
      </ul>
      <p class="mt-6 max-w-3xl" style="color: var(--muted);">{c.submitHow}</p>
      <p class="mt-3 font-mono text-sm" style="color: var(--accent-gold);">{c.submitSubject}</p>
      <p class="mt-6 text-xs uppercase tracking-[0.2em]" style="color: var(--faint);">{c.submitEmailLabel}</p>
      <a class="text-lg underline-offset-4 hover:underline" href={`mailto:${c.submitEmail}`} style="color: var(--accent-cyan);">
        {c.submitEmail}
      </a>
      <p class="mt-6 max-w-3xl" style="color: var(--muted);">{c.reviewNote}</p>
      <dl class="mt-8 grid gap-5 sm:grid-cols-2">
        <div class="card-hover rounded-3xl p-6" style="background: var(--card);">
          <dt class="text-xs uppercase tracking-[0.2em]" style="color: var(--faint);">{c.deadlineLabel}</dt>
          <dd class="mt-2" style="color: var(--ink);">{c.deadlineValue}</dd>
        </div>
        <div class="card-hover rounded-3xl p-6" style="background: var(--card);">
          <dt class="text-xs uppercase tracking-[0.2em]" style="color: var(--faint);">{c.acceptanceLabel}</dt>
          <dd class="mt-2" style="color: var(--ink);">{c.acceptanceValue}</dd>
        </div>
      </dl>
      <h3 class:list={["mt-10 text-sm uppercase tracking-[0.2em]", kickerClass]} style="color: var(--accent-gold);">
        {c.feesLabel}
      </h3>
      <div class="mt-4 grid gap-5 sm:grid-cols-2">
        {
          c.fees.map((fee) => (
            <article class="card-hover rounded-3xl p-6" style="background: var(--fee-wash);">
              <p class="text-sm" style="color: var(--muted);">{fee.label}</p>
              <p class:list={["mt-2 text-3xl", titleClass]} style="color: var(--accent-gold);">{fee.value}</p>
            </article>
          ))
        }
      </div>
      <h3 class:list={["mt-10 text-sm uppercase tracking-[0.2em]", kickerClass]} style="color: var(--accent-gold);">
        {c.mealsLabel}
      </h3>
      <p class="mt-3 max-w-3xl" style="color: var(--muted);">{c.mealsValue}</p>
    </section>

    <section id="venue" class="mx-auto max-w-6xl px-5 py-20">
      <div class="card-hover overflow-hidden rounded-[2rem] p-8 sm:p-12" style="background: var(--venue-wash);">
        <p class:list={["text-xs uppercase tracking-[0.32em]", kickerClass]} style="color: var(--accent-cyan);">
          {c.venueKicker}
        </p>
        <h2 class:list={["mt-3 text-3xl sm:text-4xl", titleClass]} style="color: var(--ink);">{c.venueTitle}</h2>
        <p class="mt-5 max-w-2xl" style="color: var(--muted);">{c.venueBody}</p>
        <dl class="mt-8 grid gap-6 sm:grid-cols-3">
          {
            c.venueFacts.map((fact) => (
              <div>
                <dt class="text-xs uppercase tracking-[0.2em]" style="color: var(--faint);">{fact.label}</dt>
                <dd class="mt-1" style="color: var(--ink);">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
        <h3 class:list={["mt-10 text-sm uppercase tracking-[0.2em]", kickerClass]} style="color: var(--accent-gold);">
          {c.contactTitle}
        </h3>
        <div class="mt-4 grid gap-5 sm:grid-cols-2">
          {
            c.contacts.map((person) => (
              <div>
                <p style="color: var(--ink);">{person.name}</p>
                <p class="mt-1 text-sm" style="color: var(--muted);">{person.role}</p>
                <a class="mt-1 inline-block" href={`tel:${person.phone}`} style="color: var(--accent-cyan);">
                  {person.phone}
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t px-5 py-10 text-center text-sm" style="border-color: var(--line); color: var(--faint);">
    <p>{c.footerCredit}</p>
    <p class="mt-3">
      <a
        class="underline-offset-4 hover:underline"
        href={c.essHref}
        target="_blank"
        rel="noopener noreferrer"
        style="color: var(--accent-cyan);"
      >
        {c.essLinkLabel}
      </a>
    </p>
    <p class="mt-2">{c.footerNote}</p>
  </footer>
</div>
