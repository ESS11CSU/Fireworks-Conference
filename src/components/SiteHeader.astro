---
import type { Lang } from "../i18n/copy";
import { t } from "../i18n/copy";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t(lang);
---

<header
  class="sticky top-0 z-40 border-b backdrop-blur-xl"
  style="border-color: var(--line); background: var(--header);"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-4 py-3 sm:gap-4 sm:px-5 sm:py-4">
    <a href="#top" class="flex min-w-0 flex-1 items-center no-underline">
      <span class:list={["min-w-0 text-sm tracking-[0.16em] sm:text-base sm:tracking-[0.2em]", lang === "zh" ? "font-zh-sans" : "uppercase"]} style="color: var(--faint);">
        {c.brandSuffix}
      </span>
    </a>
    <nav class="hidden items-center gap-3 text-base font-medium lg:flex xl:gap-5 xl:text-lg" style="color: var(--muted);">
      {
        c.nav.map((item) => (
          <a class="transition hover:opacity-80" href={item.href} style="color: inherit;">
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
      <ThemeToggle lang={lang} />
      <a
        href={c.otherHref}
        class="inline-flex h-10 min-w-10 shrink-0 items-center justify-center whitespace-nowrap rounded-full border px-2 text-xs font-semibold tracking-wide sm:h-auto sm:min-w-0 sm:px-3 sm:py-1"
        style="border-color: var(--line-strong); color: var(--ink);"
      >
        {c.otherLang}
      </a>
    </div>
  </div>
  <nav class="flex gap-4 overflow-x-auto px-5 pb-3 text-sm font-medium lg:hidden" style="color: var(--muted);">
    {
      c.nav.map((item) => (
        <a class="shrink-0" href={item.href} style="color: inherit;">
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
