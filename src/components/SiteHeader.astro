---
import type { Lang } from "../i18n/copy";
import { t } from "../i18n/copy";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t(lang);
---

<header
  class="sticky top-0 z-40 border-b border-white/10 bg-[#070414]/75 backdrop-blur-xl"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4">
    <a href="#top" class="flex items-baseline gap-2 no-underline">
      <span class="font-display text-xl text-amber-200">{c.brand}</span>
      <span class="text-[11px] uppercase tracking-[0.22em] text-white/55">
        {c.brandSuffix}
      </span>
    </a>
    <nav class="hidden items-center gap-6 text-sm text-white/80 md:flex">
      {
        c.nav.map((item) => (
          <a class="transition hover:text-amber-200" href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <a
      href={c.otherHref}
      class="rounded-full border border-white/20 px-3 py-1 text-xs font-semibold tracking-wide text-white/80 hover:border-amber-200 hover:text-amber-200"
    >
      {c.otherLang}
    </a>
  </div>
</header>
