---
import type { Lang } from "../i18n/copy";
import { t } from "../i18n/copy";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t(lang);
const isZh = lang === "zh";
const titleClass = isZh ? "font-zh-display font-bold" : "font-display";
const kickerClass = isZh ? "font-zh-sans font-bold" : "font-semibold";
---

<div
  id="splash"
  class="fixed inset-0 z-[80] flex h-[100dvh] w-screen flex-col items-center justify-center overflow-hidden bg-[#070414] text-white"
>
  <canvas id="fireworks" class="absolute inset-0 h-full w-full"></canvas>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(255,77,141,0.18),transparent_45%),radial-gradient(circle_at_20%_20%,rgba(92,225,255,0.16),transparent_35%)]"
  >
  </div>
  <div class="relative z-10 w-full max-w-[96vw] px-3 text-center sm:px-6">
    {c.splashKicker && (
      <p class:list={["text-[11px] uppercase tracking-[0.35em] text-cyan-200", kickerClass]}>
        {c.splashKicker}
      </p>
    )}
    <h1 class:list={["text-balance text-white", isZh ? "text-[clamp(2.5rem,12vw,5rem)] leading-tight sm:whitespace-nowrap sm:text-[clamp(2rem,6.8vw,5rem)] sm:leading-none" : "text-[clamp(2.25rem,10vw,3.5rem)] leading-[1.05] tracking-[-0.02em] sm:whitespace-nowrap sm:text-[clamp(1.25rem,3.35vw,4rem)] sm:leading-none", titleClass]}>
      {c.splashTitle}
    </h1>
    {c.splashSubtitle && (
      <p class:list={["mt-5 text-amber-200", isZh ? "font-zh-display text-[clamp(1.15rem,3.5vw,2.5rem)] font-bold leading-tight" : "font-display text-[clamp(1.35rem,3vw,2.25rem)] leading-tight"]}>
        {c.splashSubtitle}
      </p>
    )}
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <button
        id="enter-meeting"
        type="button"
        class="pointer-events-auto rounded-full bg-gradient-to-r from-fuchsia-500 via-rose-500 to-amber-400 px-7 py-3 text-sm font-semibold text-night shadow-[0_0_32px_rgba(255,77,141,0.45)] transition hover:scale-[1.03]"
      >
        {c.splashCta}
      </button>
      <button
        id="skip-splash"
        type="button"
        class="pointer-events-auto text-xs uppercase tracking-[0.2em] text-white/60 underline-offset-4 hover:text-white hover:underline"
      >
        {c.skipSplash}
      </button>
    </div>
  </div>
</div>

<script>
  const splash = document.getElementById("splash");
  const canvas = document.getElementById("fireworks") as HTMLCanvasElement | null;
  const enter = document.getElementById("enter-meeting");
  const skip = document.getElementById("skip-splash");
  const seenKey = "firework-ess-splash-seen";

  let hidden = false;
  const hide = () => {
    if (!splash || hidden) return;
    hidden = true;
    splash.style.transition = "opacity 500ms ease";
    splash.style.opacity = "0";
    window.setTimeout(() => splash.remove(), 520);
    try {
      sessionStorage.setItem(seenKey, "1");
    } catch {
      /* private mode */
    }
  };

  try {
    if (sessionStorage.getItem(seenKey) === "1") {
      splash?.remove();
    }
  } catch {
    /* continue with splash */
  }

  enter?.addEventListener("click", hide);
  skip?.addEventListener("click", hide);

  if (splash && document.body.contains(splash)) {
    window.setTimeout(hide, 4600);
  }

  if (canvas && splash && document.body.contains(splash)) {
    const ctx = canvas.getContext("2d");
    if (ctx) {
      const colors = ["#ff4d8d", "#ffd166", "#5ce1ff", "#b8ff6a", "#c084fc", "#ff8a4c"];
      type Spark = {
        x: number;
        y: number;
        vx: number;
        vy: number;
        life: number;
        color: string;
      };
      const sparks: Spark[] = [];
      let rockets: { x: number; y: number; vy: number; color: string }[] = [];

      const resize = () => {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      };
      resize();
      window.addEventListener("resize", resize);

      const burst = (x: number, y: number, color: string) => {
        for (let i = 0; i < 46; i += 1) {
          const angle = (Math.PI * 2 * i) / 46 + Math.random() * 0.2;
          const speed = 1.6 + Math.random() * 3.4;
          sparks.push({
            x,
            y,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            life: 1,
            color,
          });
        }
      };

      const launch = () => {
        rockets.push({
          x: canvas.width * (0.15 + Math.random() * 0.7),
          y: canvas.height,
          vy: -(7 + Math.random() * 4),
          color: colors[Math.floor(Math.random() * colors.length)]!,
        });
      };

      launch();
      const launchTimer = window.setInterval(launch, 700);

      const tick = () => {
        if (!document.body.contains(splash)) {
          window.clearInterval(launchTimer);
          return;
        }
        ctx.fillStyle = "rgba(7, 4, 20, 0.22)";
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        rockets = rockets.filter((rocket) => {
          rocket.y += rocket.vy;
          rocket.vy += 0.06;
          ctx.beginPath();
          ctx.fillStyle = rocket.color;
          ctx.arc(rocket.x, rocket.y, 2.4, 0, Math.PI * 2);
          ctx.fill();
          if (rocket.vy >= -1.2 || rocket.y < canvas.height * 0.22) {
            burst(rocket.x, rocket.y, rocket.color);
            return false;
          }
          return true;
        });

        for (let i = sparks.length - 1; i >= 0; i -= 1) {
          const spark = sparks[i]!;
          spark.x += spark.vx;
          spark.y += spark.vy;
          spark.vy += 0.035;
          spark.life -= 0.016;
          ctx.globalAlpha = Math.max(spark.life, 0);
          ctx.fillStyle = spark.color;
          ctx.fillRect(spark.x, spark.y, 2.2, 2.2);
          ctx.globalAlpha = 1;
          if (spark.life <= 0) sparks.splice(i, 1);
        }

        requestAnimationFrame(tick);
      };
      tick();
    }
  }
</script>
